# URL usada pelo frontend. O Vite encaminha /api ao backend Crow local.
VITE_API_URL=/api
# Opcional: VITE_API_PROXY_TARGET=http://127.0.0.1:18080

# Quais recursos usam a API simulada (docs/integracao-backend.md). Sem esta variável, usa o backend:
#   todos | lista com auth, espacos, reservas | vazio = tudo real
# Para usar os dados de demonstração no navegador:
# VITE_API_SIMULADA=todos
